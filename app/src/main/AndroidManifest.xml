<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No INTERNET permission, by design. CoffeeGrams makes no network calls
      outside Play Billing, which does not require one. Adding INTERNET here
      would undermine the "no data collected" Data safety declaration.
    -->

    <!-- The Pro unlock, backed by Play Billing (M8). -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <!--
      Runtime permission (API 33+) for the cold-brew / French-press
      reminder. Declaring it here only makes the system *permission*
      requestable — the actual request prompt is triggered from Compose UI
      (M7) via rememberLauncherForActivityResult; on earlier API levels
      notifications are allowed by default and this permission is a no-op.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Normal (not runtime) permission — required for LiveHaptics's Vibrator calls. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      M9 — keeps the process alive (and shows the ongoing notification) while
      a guided brew is running, so Doze/background OOM-kill don't lose it.
      FOREGROUND_SERVICE_SPECIAL_USE is required in addition to the general
      permission as of API 34 — each declared foreground service type needs
      its own matching permission, or startForeground() throws.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".CoffeeGramsApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CoffeeGrams"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CoffeeGrams"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          M9 — declares the specialUse type; startForeground() must hold the
          matching FOREGROUND_SERVICE_SPECIAL_USE permission above.
          android:foregroundServiceType is what the OS enforces at runtime;
          PROPERTY_SPECIAL_USE_FGS_SUBTYPE's value is the justification string
          Play reviews at submission (M11/M12) — a matching declaration also
          needs to be added on the app's "App content" page in Play Console
          before then, see testing.md.
        -->
        <service
            android:name=".platform.BrewTimerForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows the current step and elapsed time while the user is actively guided through brewing a cup of coffee, and keeps the timer running accurately if the app is backgrounded mid-brew." />
        </service>
    </application>

</manifest>
