<?xml version="1.0" encoding="utf-8"?>
<!--
  minSdk is 26, so the adaptive icon is the only variant needed — there is no
  pre-Oreo fallback to maintain. Foreground/monochrome share one drawable;
  see ic_launcher_foreground.xml for provenance and the monochrome-tinting
  rationale.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
