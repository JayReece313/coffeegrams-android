# Copy to keystore.properties (git-ignored, machine-local) and fill in the
# real values after generating the upload keystore. Never commit the real
# file — see Releases/play-console-release.md for how to generate the
# keystore and .gitignore for what's already excluded.
storeFile=/absolute/path/to/coffeegrams-upload.jks
storePassword=
keyAlias=coffeegrams
keyPassword=
